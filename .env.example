# --- Active keys (the running pipelines use these; rotate before going public) ---
# Live HDA odds + completed scores (the-odds-api.com, free 500/mo).
ODDS_API_KEY=
# Team-intel processor: any OpenAI-compatible endpoint. Default = Groq free tier
# (console.groq.com). Leave blank only for a local Ollama endpoint.
INTEL_API_KEY=
# Intel corpus providers (Track B). Each is optional and degrades gracefully if
# absent; the deep RAG path is strongest with all three.
GUARDIAN_API_KEY=        # full-text journalism (open-platform.theguardian.com)
WORLDNEWS_API_KEY=       # full-text redundancy (worldnewsapi.com)
APIFOOTBALL_API_KEY=     # structured injuries (dashboard.api-football.com)
TZ=Asia/Jerusalem

# --- Reserved for not-yet-wired scrapers (safe to leave blank) ---
FOOTBALL_DATA_TOKEN=     # football-data.org stub scraper (NotImplementedError)
